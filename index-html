function detectCategory(text){
  const t = text.toLowerCase();
  let bestMatch = 'general', bestScore = 0;
  for(const [cat, data] of Object.entries(aiTemplates)){
    if(cat === 'general') continue;
    let score = 0;
    for(const kw of data.keywords){
      if(t.includes(kw)) score += kw.length;
    }
    if(score > bestScore){bestScore = score; bestMatch = cat}
  }
  return bestMatch;
}

function randomPick(arr){return arr[Math.floor(Math.random()*arr.length)]}

function generateLocalPrayer(input){
  const cat = detectCategory(input);
  const t = aiTemplates[cat];
  const intro = randomPick(t.intros);
  const middle = randomPick(t.middles);
  const ending = randomPick(t.endings);
  const verse = randomPick(t.verses);
  
  return `<p>${intro}</p><p style="margin-top:14px">${middle}</p><p style="margin-top:14px">${ending}</p><p style="margin-top:20px;text-align:center;font-family:Cinzel,serif;font-size:14px;color:var(--green);letter-spacing:1px;padding-top:14px;border-top:1px solid var(--gold)">${verse}</p>`;
}

