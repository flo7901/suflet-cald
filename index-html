<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Suflet Cald — Rugăciuni Sfinte cu AI Personalizat</title>
<meta name="description" content="Site-ul de rugăciuni cu AI care creează rugăciuni personalizate pentru tine." />
<meta name="theme-color" content="#C8102E" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Berkshire+Swash&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Cinzel:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="manifest" href="manifest.json" />
<link rel="icon" type="image/png" href="logo.png" />
<style>
:root{--parchment:#FBF6E8;--parchment-dark:#F2E9CC;--ink:#3A2A1A;--gold:#B8860B;--gold-light:#D4A84B;--red:#C8102E;--green:#1A6B36;--yellow:#FFE066}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Cormorant Garamond',serif;background:var(--parchment);color:var(--ink);line-height:1.7;font-size:18px;background-image:radial-gradient(circle at 10% 20%, rgba(184,134,11,0.06) 0%, transparent 50%),radial-gradient(circle at 90% 80%, rgba(200,16,46,0.04) 0%, transparent 50%)}
header{position:sticky;top:0;z-index:50;background:rgba(251,246,232,0.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(184,134,11,0.2);padding:14px 24px}
.nav{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}
.logo{font-family:'Berkshire Swash',cursive;font-size:26px;color:var(--red);text-decoration:none;display:flex;align-items:center;gap:8px}
.logo::before{content:'✦';color:var(--gold)}
.nav-links{display:flex;gap:20px;list-style:none;flex-wrap:wrap}
.nav-links a{color:var(--ink);text-decoration:none;font-family:'Cinzel',serif;font-size:13px;letter-spacing:1px;text-transform:uppercase;transition:color .3s}
.nav-links a:hover{color:var(--red)}
@media(max-width:768px){.nav-links{display:none}}
.hero{min-height:90vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:80px 24px;background:linear-gradient(180deg, rgba(251,246,232,0.7) 0%, rgba(251,246,232,0.95) 100%),radial-gradient(ellipse at center, rgba(255,224,102,0.3) 0%, transparent 70%);position:relative}
.hero::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:300px;height:300px;background:radial-gradient(circle, rgba(255,224,102,0.4) 0%, transparent 70%);filter:blur(40px);z-index:0;animation:glow 4s ease-in-out infinite alternate}
@keyframes glow{from{opacity:.6}to{opacity:1;transform:translate(-50%,-50%) scale(1.1)}}
.hero-content{position:relative;z-index:1;max-width:900px}
.hero-tag{font-family:'Cinzel',serif;font-size:13px;letter-spacing:4px;color:var(--gold);text-transform:uppercase;margin-bottom:24px}
.hero h1{font-family:'Berkshire Swash',cursive;font-size:clamp(40px,7vw,72px);color:var(--red);line-height:1.1;margin-bottom:24px;text-shadow:2px 2px 0 rgba(184,134,11,0.15)}
.hero p{font-size:22px;color:var(--ink);margin-bottom:40px;font-style:italic}
.hero-buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btn{display:inline-block;padding:16px 36px;background:var(--red);color:var(--parchment);text-decoration:none;font-family:'Cinzel',serif;font-size:13px;letter-spacing:2px;text-transform:uppercase;border:none;cursor:pointer;transition:all .3s;border-radius:2px;box-shadow:0 4px 20px rgba(200,16,46,0.3)}
.btn:hover{background:var(--green);transform:translateY(-2px);box-shadow:0 6px 25px rgba(26,107,54,0.4)}
.btn-outline{background:transparent;color:var(--red);border:2px solid var(--red)}
.btn-outline:hover{background:var(--red);color:var(--parchment)}
.btn-gold{background:var(--gold);color:var(--ink)}
.btn-gold:hover{background:var(--gold-light);color:var(--ink)}
section{padding:80px 24px}
.container{max-width:1200px;margin:0 auto}
.section-tag{font-family:'Cinzel',serif;font-size:12px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;text-align:center;margin-bottom:12px}
.section-title{font-family:'Berkshire Swash',cursive;font-size:clamp(32px,5vw,52px);color:var(--red);text-align:center;margin-bottom:20px}
.section-subtitle{text-align:center;font-style:italic;max-width:700px;margin:0 auto 50px;color:var(--ink);opacity:.85;font-size:19px}
.ai-section{background:linear-gradient(135deg, rgba(200,16,46,0.05) 0%, rgba(255,224,102,0.1) 100%);border-top:2px solid var(--gold);border-bottom:2px solid var(--gold);position:relative;overflow:hidden}
.ai-badge{display:inline-block;background:var(--red);color:var(--parchment);padding:6px 14px;border-radius:20px;font-family:'Cinzel',serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px}
.ai-wrapper{max-width:800px;margin:0 auto;background:var(--parchment);border:2px solid var(--gold);padding:40px;border-radius:6px;box-shadow:0 20px 50px rgba(0,0,0,0.08);position:relative;z-index:1}
.ai-input{width:100%;padding:18px;background:var(--parchment-dark);border:1px solid rgba(184,134,11,0.4);font-family:'Cormorant Garamond',serif;font-size:18px;color:var(--ink);min-height:120px;resize:vertical;border-radius:4px;margin-bottom:16px}
.ai-input:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(200,16,46,0.1)}
.ai-quick{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.ai-quick-btn{padding:8px 16px;background:var(--parchment-dark);border:1px solid var(--gold);color:var(--ink);font-family:'Cinzel',serif;font-size:11px;letter-spacing:1px;cursor:pointer;border-radius:20px;transition:all .3s;text-transform:uppercase}
.ai-quick-btn:hover{background:var(--gold);color:var(--parchment)}
.ai-result{background:linear-gradient(135deg, var(--parchment-dark) 0%, var(--parchment) 100%);padding:32px;border-left:4px solid var(--red);margin-top:24px;display:none;font-size:18px;line-height:1.8;border-radius:4px;position:relative}
.ai-result.show{display:block;animation:fadeIn .6s}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.ai-result h4{font-family:'Berkshire Swash',cursive;font-size:24px;color:var(--red);margin-bottom:16px}
.ai-actions{display:flex;gap:8px;margin-top:20px;flex-wrap:wrap}
.ai-actions button{padding:10px 18px;font-size:11px;letter-spacing:1px}
.ai-loading{display:none;text-align:center;padding:30px;font-style:italic;color:var(--gold);font-size:18px}
.ai-loading.show{display:block}
.ai-loading::after{content:'';display:inline-block;width:20px;height:20px;border:2px solid var(--gold);border-radius:50%;border-top-color:transparent;animation:spin 1s linear infinite;margin-left:10px;vertical-align:middle}
@keyframes spin{to{transform:rotate(360deg)}}
.ai-amen{text-align:center;font-family:'Berkshire Swash',cursive;font-size:32px;color:var(--red);margin-top:20px}
.rosary-section{background:var(--parchment-dark);text-align:center}
.rosary-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:12px;max-width:600px;margin:30px auto;padding:30px;background:var(--parchment);border:2px solid var(--gold);border-radius:8px}
.bead{aspect-ratio:1;background:var(--parchment-dark);border:2px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:14px;color:var(--gold);cursor:pointer;transition:all .4s;font-weight:600}
.bead.active{background:linear-gradient(135deg, var(--red), var(--gold));color:var(--parchment);transform:scale(1.1);box-shadow:0 0 20px rgba(200,16,46,0.4)}
.bead.done{background:var(--green);color:var(--parchment);border-color:var(--green)}
.rosary-current{margin:30px auto;max-width:600px;padding:30px;background:var(--parchment);border:1px solid var(--gold);border-radius:8px;min-height:120px}
.rosary-current h3{font-family:'Berkshire Swash',cursive;color:var(--red);font-size:24px;margin-bottom:12px}
.rosary-controls{display:flex;justify-content:center;gap:12px;margin-top:20px;flex-wrap:wrap}
.plan21-section{background:var(--parchment)}
.plan-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(80px, 1fr));gap:10px;max-width:900px;margin:30px auto}
.plan-day{aspect-ratio:1;background:var(--parchment-dark);border:1px solid var(--gold);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:all .3s;border-radius:6px;padding:8px;text-align:center}
.plan-day:hover{transform:translateY(-3px);box-shadow:0 6px 15px rgba(0,0,0,0.1)}
.plan-day.completed{background:linear-gradient(135deg, var(--green), #2a8c46);color:var(--parchment);border-color:var(--green)}
.plan-day .day-num{font-family:'Berkshire Swash',cursive;font-size:18px}
.plan-day .day-title{font-size:11px;margin-top:4px;line-height:1.2}
.challenge-section{background:linear-gradient(135deg, var(--red) 0%, #8B0F22 100%);color:var(--parchment);text-align:center}
.challenge-section .section-title{color:var(--parchment)}
.challenge-card{max-width:600px;margin:30px auto;background:rgba(251,246,232,0.1);backdrop-filter:blur(10px);border:1px solid rgba(255,224,102,0.3);padding:40px;border-radius:8px}
.challenge-card h3{font-family:'Berkshire Swash',cursive;font-size:32px;color:var(--yellow);margin-bottom:16px}
.card-section{background:var(--parchment-dark)}
.encourage-card{max-width:500px;margin:0 auto;background:linear-gradient(135deg, var(--parchment) 0%, var(--parchment-dark) 100%);border:2px solid var(--gold);padding:48px 32px;border-radius:8px;text-align:center;min-height:280px;display:flex;flex-direction:column;justify-content:center;cursor:pointer;transition:transform .4s;position:relative;overflow:hidden}
.encourage-card:hover{transform:scale(1.02)}
.encourage-card::before, .encourage-card::after{content:'✦';position:absolute;color:var(--gold);font-size:20px}
.encourage-card::before{top:12px;left:14px}
.encourage-card::after{bottom:12px;right:14px}
.encourage-text{font-family:'Berkshire Swash',cursive;font-size:24px;color:var(--red);margin-bottom:20px;line-height:1.4}
.encourage-verse{font-family:'Cinzel',serif;font-size:12px;color:var(--green);letter-spacing:1px}
.journal-section{background:var(--parchment)}
.journal-form{max-width:600px;margin:0 auto;background:var(--parchment-dark);padding:32px;border:1px solid var(--gold);border-radius:6px}
.journal-form input, .journal-form textarea{width:100%;padding:14px;background:var(--parchment);border:1px solid rgba(184,134,11,0.4);font-family:'Cormorant Garamond',serif;font-size:17px;color:var(--ink);margin-bottom:12px;border-radius:3px}
.journal-form textarea{min-height:100px;resize:vertical}
.journal-entries{max-width:600px;margin:30px auto 0}
.journal-entry{background:var(--parchment-dark);padding:20px;margin-bottom:12px;border-left:3px solid var(--gold);border-radius:0 6px 6px 0;position:relative}
.journal-entry-date{font-family:'Cinzel',serif;font-size:11px;color:var(--gold);letter-spacing:1px;margin-bottom:6px}
.journal-entry-title{font-family:'Berkshire Swash',cursive;font-size:20px;color:var(--red);margin-bottom:6px}
.journal-entry-delete{position:absolute;top:8px;right:12px;background:none;border:none;color:var(--red);cursor:pointer;font-size:18px;opacity:.4}
.journal-entry-delete:hover{opacity:1}
.search-section{background:var(--parchment-dark)}
.search-buttons{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;max-width:800px;margin:30px auto}
.search-btn{padding:10px 20px;background:var(--parchment);border:1px solid var(--gold);font-family:'Cinzel',serif;font-size:12px;letter-spacing:1px;color:var(--ink);cursor:pointer;border-radius:30px;transition:all .3s;text-transform:uppercase}
.search-btn:hover{background:var(--red);color:var(--parchment);border-color:var(--red)}
.search-result{max-width:700px;margin:30px auto 0;background:var(--parchment);padding:30px;border:2px solid var(--gold);border-radius:6px;display:none}
.search-result.show{display:block;animation:fadeIn .5s}
.search-result h4{font-family:'Berkshire Swash',cursive;font-size:24px;color:var(--red);margin-bottom:12px}
.search-result blockquote{font-size:18px;font-style:italic;border-left:3px solid var(--gold);padding-left:16px;margin:14px 0;color:var(--ink)}
.daily-prayer{background:linear-gradient(135deg, var(--parchment-dark) 0%, var(--parchment) 100%);border:1px solid rgba(184,134,11,0.3);border-radius:4px;padding:48px;text-align:center;position:relative;max-width:800px;margin:0 auto}
.daily-prayer::before, .daily-prayer::after{content:'✦';position:absolute;color:var(--gold);font-size:24px}
.daily-prayer::before{top:16px;left:16px}
.daily-prayer::after{bottom:16px;right:16px}
.daily-date{font-family:'Cinzel',serif;font-size:14px;color:var(--gold);letter-spacing:2px;margin-bottom:8px;text-transform:uppercase}
.daily-title{font-family:'Berkshire Swash',cursive;font-size:32px;color:var(--red);margin:16px 0}
.daily-text{font-size:20px;font-style:italic;margin:24px 0;color:var(--ink)}
.daily-verse{font-family:'Cinzel',serif;font-size:14px;color:var(--green);letter-spacing:1px;margin-top:24px}
.prayers-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:24px;margin-top:40px}
.prayer-card{background:var(--parchment-dark);border:1px solid rgba(184,134,11,0.3);padding:32px;cursor:pointer;transition:all .4s cubic-bezier(.2,.8,.2,1);position:relative;overflow:hidden;border-radius:4px}
.prayer-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg, var(--gold), var(--red), var(--gold));transform:scaleX(0);transform-origin:left;transition:transform .4s}
.prayer-card:hover{transform:translateY(-6px);box-shadow:0 12px 30px rgba(58,42,26,0.15)}
.prayer-card:hover::before{transform:scaleX(1)}
.prayer-number{font-family:'Cinzel',serif;font-size:11px;color:var(--gold);letter-spacing:3px;margin-bottom:12px}
.prayer-card h3{font-family:'Berkshire Swash',cursive;font-size:26px;color:var(--red);margin-bottom:12px}
.prayer-card p{font-size:16px;color:var(--ink);opacity:.8}
.prayer-card-cta{margin-top:20px;font-family:'Cinzel',serif;font-size:11px;color:var(--green);letter-spacing:2px;text-transform:uppercase}
.products-section{background:rgba(184,134,11,0.05)}
.products-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:24px}
.product-card{background:var(--parchment);border:1px solid rgba(184,134,11,0.3);padding:32px;text-align:center;transition:all .3s;border-radius:4px}
.product-card:hover{transform:translateY(-4px);box-shadow:0 10px 25px rgba(0,0,0,0.08)}
.product-icon{font-size:48px;margin-bottom:16px}
.product-card h3{font-family:'Berkshire Swash',cursive;font-size:22px;color:var(--red);margin-bottom:8px}
.product-price{font-family:'Cinzel',serif;font-size:24px;color:var(--green);margin:12px 0 20px;font-weight:600}
.product-btn{display:inline-block;padding:12px 28px;background:var(--red);color:var(--parchment);text-decoration:none;font-family:'Cinzel',serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;transition:all .3s}
.product-btn:hover{background:var(--green)}
.testimonials-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:24px}
.testimonial-card{background:var(--parchment-dark);padding:32px;border-left:3px solid var(--gold);font-style:italic;border-radius:0 6px 6px 0}
.testimonial-card p{margin-bottom:16px;font-size:17px}
.testimonial-name{font-family:'Cinzel',serif;font-size:13px;color:var(--green);letter-spacing:1px;font-style:normal}
.prayer-request{background:linear-gradient(135deg, var(--parchment-dark) 0%, var(--parchment) 100%);padding:60px 32px;text-align:center}
.form-wrapper{max-width:600px;margin:0 auto}
.form-input, .form-textarea{width:100%;padding:14px 18px;background:var(--parchment);border:1px solid rgba(184,134,11,0.4);font-family:'Cormorant Garamond',serif;font-size:17px;color:var(--ink);margin-bottom:16px;border-radius:2px}
.form-input:focus, .form-textarea:focus{outline:none;border-color:var(--red)}
.form-textarea{min-height:120px;resize:vertical}
.newsletter{background:var(--red);color:var(--parchment);padding:60px 24px;text-align:center}
.newsletter h2{font-family:'Berkshire Swash',cursive;font-size:42px;margin-bottom:16px;color:var(--parchment)}
.newsletter p{font-size:18px;margin-bottom:32px;opacity:.95}
.newsletter-form{display:flex;gap:12px;max-width:500px;margin:0 auto;flex-wrap:wrap}
.newsletter-form input{flex:1;min-width:200px;padding:14px 18px;border:none;font-family:'Cormorant Garamond',serif;font-size:16px}
.newsletter-form button{padding:14px 28px;background:var(--gold);color:var(--ink);border:none;font-family:'Cinzel',serif;font-size:13px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:background .3s}
.newsletter-form button:hover{background:var(--gold-light)}
.counter-section{text-align:center;background:var(--ink);color:var(--parchment);padding:60px 24px}
.counter-section h3{font-family:'Berkshire Swash',cursive;font-size:36px;color:var(--yellow);margin-bottom:30px}
.counters{display:flex;justify-content:center;gap:60px;flex-wrap:wrap}
.counter{text-align:center}
.counter-num{font-family:'Berkshire Swash',cursive;font-size:48px;color:var(--gold)}
.counter-label{font-family:'Cinzel',serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;opacity:.8}
.blessing{text-align:center;padding:80px 24px;background:radial-gradient(ellipse at center, rgba(255,224,102,0.15) 0%, transparent 70%)}
.blessing-symbol{font-size:32px;color:var(--gold);margin-bottom:24px}
.blessing-text{font-family:'Berkshire Swash',cursive;font-size:clamp(24px,3.5vw,38px);color:var(--red);max-width:900px;margin:0 auto;line-height:1.4}
.blessing-source{font-family:'Cinzel',serif;font-size:14px;color:var(--green);letter-spacing:2px;margin-top:24px}
footer{background:var(--ink);color:var(--parchment);padding:60px 24px 32px;text-align:center}
.footer-logo{font-family:'Berkshire Swash',cursive;font-size:32px;color:var(--gold);margin-bottom:16px}
.footer-text{opacity:.8;margin-bottom:32px;font-style:italic}
.social-links{display:flex;justify-content:center;gap:20px;margin-bottom:32px;flex-wrap:wrap}
.social-links a{width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:rgba(251,246,232,0.1);border-radius:50%;color:var(--parchment);text-decoration:none;transition:all .3s;font-size:20px}
.social-links a:hover{background:var(--gold);color:var(--ink);transform:translateY(-3px)}
.footer-copy{font-size:14px;opacity:.6;letter-spacing:1px}
.modal{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(58,42,26,0.85);z-index:100;align-items:center;justify-content:center;padding:24px;backdrop-filter:blur(4px)}
.modal.active{display:flex}
.modal-content{background:var(--parchment);max-width:700px;width:100%;max-height:90vh;overflow-y:auto;padding:48px;border-radius:4px;position:relative;border:2px solid var(--gold);animation:modalIn .4s cubic-bezier(.2,.8,.2,1)}
@keyframes modalIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.modal-close{position:absolute;top:16px;right:20px;background:none;border:none;font-size:32px;color:var(--red);cursor:pointer;line-height:1}
.modal h2{font-family:'Berkshire Swash',cursive;font-size:36px;color:var(--red);text-align:center;margin-bottom:24px}
.modal-prayer-text{font-size:18px;line-height:1.9;color:var(--ink);margin-bottom:24px}
.modal-prayer-text strong{color:var(--red);font-weight:600}
.modal-prayer-text em.green{color:var(--green);font-style:normal;font-weight:600}
.modal-verse{text-align:center;font-family:'Cinzel',serif;font-size:14px;color:var(--green);padding:16px;border-top:1px solid var(--gold);border-bottom:1px solid var(--gold);margin:24px 0;letter-spacing:1px}
.modal-amen{text-align:center;font-family:'Berkshire Swash',cursive;font-size:36px;color:var(--red);margin:24px 0}
.modal-actions{display:flex;gap:12px;justify-content:center;margin-top:24px;flex-wrap:wrap}
.fab-prayer{position:fixed;bottom:24px;left:24px;z-index:55;background:var(--red);color:var(--parchment);padding:14px 24px;border:none;cursor:pointer;font-family:'Cinzel',serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;border-radius:30px;box-shadow:0 6px 20px rgba(200,16,46,0.4);transition:all .3s}
.fab-prayer:hover{background:var(--green)}
.fab-ai{position:fixed;bottom:24px;right:24px;z-index:55;background:var(--gold);color:var(--ink);padding:14px 20px;border:none;cursor:pointer;font-family:'Cinzel',serif;font-size:12px;letter-spacing:1px;text-transform:uppercase;border-radius:30px;box-shadow:0 6px 20px rgba(184,134,11,0.4);transition:all .3s;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 6px 20px rgba(184,134,11,0.4)}50%{box-shadow:0 6px 30px rgba(184,134,11,0.8)}}
.fab-ai:hover{background:var(--gold-light)}
@media(max-width:600px){.fab-prayer,.fab-ai{padding:12px 16px;font-size:10px}}
</style>
</head>
<body>

