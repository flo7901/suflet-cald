function renderJournal(){
  const entries = JSON.parse(localStorage.getItem('journal')||'[]');
  const luni=['ian','feb','mar','apr','mai','iun','iul','aug','sep','oct','noi','dec'];
  const html = entries.map((e,i)=>{
    const d = new Date(e.date);
    return `<div class="journal-entry"><button class="journal-entry-delete" onclick="deleteJournal(${i})">×</button><div class="journal-entry-date">${d.getDate()} ${luni[d.getMonth()]} ${d.getFullYear()}</div><div class="journal-entry-title">${e.title}</div><div>${e.content.replace(/\n/g,'<br/>')}</div></div>`;
  }).join('');
  document.getElementById('journalEntries').innerHTML = html;
}
function deleteJournal(i){
  if(!confirm('Ștergi această intrare?')) return;
  const entries = JSON.parse(localStorage.getItem('journal')||'[]');
  entries.splice(i,1);
  localStorage.setItem('journal',JSON.stringify(entries));
  renderJournal();
}
