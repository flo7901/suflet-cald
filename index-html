const DP=[{t:'Pentru cei dragi',x:'Binecuvântează pe toți cei pe care îi iubesc.',v:'„Tu și casa ta veți fi mântuiți." — Fapte 16:31'},{t:'Pentru ziua aceasta',x:'Doamne, dă-mi har să trec prin această zi cu pace.',v:'„Aceasta este ziua pe care a făcut-o Domnul." — Psalmul 118:24'},{t:'Pentru putere',x:'Tată, întărește-mă astăzi.',v:'„Cei ce se încred în Domnul își înnoiesc puterea." — Isaia 40:31'},{t:'Pentru pace',x:'Doamne, dăruiește-mi pacea Ta.',v:'„Vă las pacea Mea." — Ioan 14:27'},{t:'Pentru credință',x:'Isuse, crește-mi credința.',v:'„Credința este o încredere neclintită." — Evrei 11:1'},{t:'Pentru iertare',x:'Doamne, iartă-mi greșelile.',v:'„Iertați și veți fi iertați." — Luca 6:37'},{t:'Pentru bucurie',x:'Tată, umple-mi inima de bucuria Ta.',v:'„Bucuria Domnului este tăria voastră." — Neemia 8:10'}];
