let currentPrayer = 0;
function openModal(i){
  currentPrayer = i;
  document.getElementById('modalTitle').innerHTML = prayers[i].icon + ' ' + prayers[i].title;
  document.getElementById('modalText').innerHTML = prayers[i].text;
  document.getElementById('modalVerse').textContent = prayers[i].verse;
  document.getElementById('prayerModal').classList.add('active');
  document.body.style.overflow='hidden';
}
function closeModal(){
  document.getElementById('prayerModal').classList.remove('active');
  document.body.style.overflow='';
}
function sharePrayer(){
  const p = prayers[currentPrayer];
  const text = p.title+'\n\n'+p.text.replace(/<[^>]*>/g,'')+'\n\n'+p.verse+'\n\nAMIN\n\n'+window.location.href;
  if(navigator.share) navigator.share({title:p.title,text:text}).catch(()=>{});
  else window.open('https://wa.me/?text='+encodeURIComponent(text),'_blank');
}
document.getElementById('prayerModal').onclick=(e)=>{if(e.target.id==='prayerModal') closeModal()};

