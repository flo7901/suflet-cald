function generateAIPrayer(){
  const input = document.getElementById('aiInput').value.trim();
  if(!input){
    alert('🙏 Spune-mi pentru ce vrei să te rogi');
    return;
  }
  
  document.getElementById('aiLoading').classList.add('show');
  document.getElementById('aiResult').classList.remove('show');
  
  // Generăm întotdeauna local (instant, garantat)
  setTimeout(()=>{
    const html = generateLocalPrayer(input);
    document.getElementById('aiResultText').innerHTML = html;
    document.getElementById('aiLoading').classList.remove('show');
    document.getElementById('aiResult').classList.add('show');
    document.getElementById('aiResult').scrollIntoView({behavior:'smooth',block:'center'});
    
